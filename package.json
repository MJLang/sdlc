{
  "name": "@mlangroman/sdlc",
  "version": "0.6.0",
  "description": "Ticket → plan → implement → land: an agentic SDLC pipeline as installable agent skills, with one-command project setup (thoughts/ folder, AGENTS.md/CLAUDE.md symlinks, beads issue tracking).",
  "keywords": [
    "agent-skills",
    "skills",
    "claude-code",
    "sdlc",
    "beads",
    "workflow",
    "agents"
  ],
  "license": "MIT",
  "author": "Martin Lang <martin@mercator.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MJLang/sdlc.git"
  },
  "type": "module",
  "bin": {
    "sdlc": "bin/sdlc.mjs"
  },
  "exports": {
    ".": "./lib/index.mjs",
    "./artifacts": "./lib/artifacts.mjs",
    "./beads": "./lib/beads.mjs",
    "./config": "./lib/config.mjs",
    "./doctor": "./lib/doctor.mjs",
    "./fingerprint": "./lib/fingerprint.mjs",
    "./gates": "./lib/gates.mjs",
    "./guard": "./lib/guard.mjs",
    "./resume": "./lib/resume.mjs",
    "./review-artifact": "./lib/review-artifact.mjs",
    "./review-packet": "./lib/review-packet.mjs",
    "./snapshot": "./lib/snapshot.mjs",
    "./working-tree": "./lib/working-tree.mjs"
  },
  "scripts": {
    "bump:minor": "node scripts/bump-version.mjs minor",
    "bump:patch": "node scripts/bump-version.mjs patch",
    "config:docs": "node scripts/render-config-reference.mjs",
    "test": "node --test"
  },
  "files": [
    "bin/",
    "docs/",
    "lib/",
    "skills/",
    "template/"
  ],
  "engines": {
    "node": ">=18"
  }
}
