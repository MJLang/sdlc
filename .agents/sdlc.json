{
  "$schema": "./sdlc.schema.json",
  "version": 1,
  "targets": [
    {
      "name": "sdlc",
      "paths": ["bin/**", "lib/**", "scripts/**", "skills/**", "template/**", "test/**"],
      "reviewers": ["backend-code-reviewer"]
    }
  ],
